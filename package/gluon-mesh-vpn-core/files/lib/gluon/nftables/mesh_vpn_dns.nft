# Redirect DNS queries of mesh VPN processes (group gluon-mesh-vpn) to
# the gluon-wan-dnsmasq instance on port 54. firewall4 provides no
# output-hook NAT chain, so this needs its own table.
#
# resolv.conf lists ::1 next to 127.0.0.1 and musl queries every
# nameserver in parallel, so both families have to be redirected.

table inet gluon_mesh_vpn
delete table inet gluon_mesh_vpn
table inet gluon_mesh_vpn {
	chain dns_output {
		type nat hook output priority dstnat; policy accept;
		meta skgid "gluon-mesh-vpn" oifname "lo" ip daddr 127.0.0.1 udp dport 53 redirect to :54
		meta skgid "gluon-mesh-vpn" oifname "lo" ip6 daddr ::1 udp dport 53 redirect to :54
	}
}
