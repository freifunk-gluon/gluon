-- Feature definition file
--
-- See the page `dev/packages` (Developer Documentation / Package development)
-- in the `docs` directory or on gluon.readthedocs.io for information on the
-- file format


-- The ebtables and iptables backends were replaced by a single nftables
-- one, and their packages renamed to gluon-firewall-*. Sites keep
-- building with the old feature names for now, so a site does not have
-- to be changed in the same commit that updates Gluon.
deprecated('ebtables', 'firewall')
deprecated('ebtables-filter-multicast', 'firewall-filter-multicast')
deprecated('ebtables-filter-ra-dhcp', 'firewall-filter-ra-dhcp')
deprecated('ebtables-limit-arp', 'firewall-limit-arp')
deprecated('ebtables-source-filter', 'firewall-source-filter')
deprecated('iptables-clamp-mss-to-pmtu', 'firewall-clamp-mss-to-pmtu')


feature('web-wizard', {
	'gluon-config-mode-hostname',
	'gluon-config-mode-geo-location',
	'gluon-config-mode-contact-info',
	'gluon-config-mode-outdoor',
})

when(_'web-wizard' and _'autoupdater', {
	'gluon-config-mode-autoupdater',
})

when(_'web-wizard' and (
	_'mesh-vpn-fastd' or
	_'mesh-vpn-fastd-l2tp' or
	_'mesh-vpn-wireguard'
), {
	'gluon-config-mode-mesh-vpn',
})


feature('web-advanced', {
	'gluon-web-admin',
	'gluon-web-network',
	'gluon-web-wifi-config',
})

when(_'web-advanced' and _'autoupdater', {
	'gluon-web-autoupdater',
})


when(_'mesh-batman-adv-15', {
	'gluon-firewall-limit-arp',
	'gluon-radvd',
})

when(_'status-page' and _'mesh-batman-adv-15', {
	'gluon-status-page-mesh-batman-adv',
})


when(_'mesh-olsrd', {
	'gluon-radvd',
})


when(not _'wireless-encryption-wpa3', {
	'hostapd-mini',
})
