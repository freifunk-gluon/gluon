#!/usr/bin/lua

local platform = require 'gluon.platform'
local sysconfig = require 'gluon.sysconfig'
local util = require 'gluon.util'

local json = require 'jsonc'
local uci = require('simple-uci').cursor()
local unistd = require 'posix.unistd'

local board_data = json.load('/etc/board.json')
local network_data = (board_data or {}).network

local function iface_exists(ifaces)
	if not ifaces then return nil end
	local ifnames = table.concat(ifaces, ' ')

	for _, iface in ipairs(ifaces) do
		if unistd.access('/sys/class/net/' .. iface:gsub('%..*$', '')) then
			return ifnames
		end
	end
end

local lan_data = network_data.lan or {}
local wan_data = network_data.wan or {}

local lan_interfaces = lan_data.ports
local wan_interfaces = wan_data.ports

-- In case we have a single port for either WAN or LAN,
-- add it to the respective empty table, as devices and
-- ports is XOR in board.json

if lan_data.device ~= nil then
	lan_interfaces = {lan_data.device}
end

if wan_data.device ~= nil then
	wan_interfaces = {wan_data.device}
end

-- On x86, the interfaces are renamed by /lib/gluon/rename-netif, while
-- board.json may refer to their kernel names
local function get_renamed(ifaces)
	if not ifaces or not platform.match('x86') then
		return ifaces
	end
	local ret = {}
	for _, iface in ipairs(ifaces) do
		local base, suffix = string.match(iface, '^([^.]*)(.*)$')
		table.insert(ret, (util.get_renamed_netdev(base) or base) .. suffix)
	end
	return ret
end

lan_interfaces = get_renamed(lan_interfaces)
wan_interfaces = get_renamed(wan_interfaces)

local lan_ifname = iface_exists(lan_interfaces)
local wan_ifname = iface_exists(wan_interfaces)

if platform.match('ath79', 'generic', {
	'dlink,dap-2695-a1',
	'tplink,cpe210-v1',
	'tplink,cpe210-v2',
	'tplink,cpe510-v1',
	'tplink,wbs210-v1',
	'tplink,wbs210-v2',
	'tplink,wbs510-v1',
	'ubnt,nanostation-m-xw',
	'ubnt,unifi-ap-pro',
}) then
	lan_ifname, wan_ifname = wan_ifname, lan_ifname
elseif platform.match('ath79', 'generic', {
	'ubnt,unifi-ap-outdoor-plus',
}) then
	-- Temporary solution to separate interfaces in bridged default setup
	lan_ifname, wan_ifname = 'eth0', 'eth1'
elseif platform.match('ath79', 'generic', {
	'ubnt,unifiac-mesh-pro',
	'ubnt,unifiac-pro',
}) then
	lan_ifname, wan_ifname = 'eth0.2', 'eth0.1'
elseif platform.match('ipq40xx', 'generic', {
	'avm,fritzbox-7530',
}) then
	lan_ifname, wan_ifname = 'lan2 lan3 lan4', 'lan1'
elseif platform.match('ipq40xx', 'generic', {
	'linksys,whw01',
}) then
	lan_ifname, wan_ifname = 'eth2', 'eth1'
elseif platform.match('ipq806x', 'generic', {
	'ubnt,unifi-ac-hd',
}) then
	lan_ifname, wan_ifname = 'eth1', 'eth0'
elseif platform.match('ramips', 'mt7621', {
	'netgear,wac104',
}) then
	lan_ifname, wan_ifname = 'lan2 lan3 lan4', 'lan1'
elseif platform.match('ramips', 'mt7621', {
	'tplink,eap615-wall-v1',
}) then
	lan_ifname, wan_ifname = 'lan1 lan2 lan3', 'lan0'
elseif platform.match('lantiq', 'xrx200', {
	'avm,fritz7430',
}) then
	lan_ifname, wan_ifname = 'lan2 lan3 lan4', 'lan1'
elseif platform.match('lantiq', 'xrx200', {
	'arcadyan,vgv7510kw22-nor',
}) then
	lan_ifname, wan_ifname = 'lan1 lan2 lan3 lan4', 'wan'
end

local roles = {'lan', 'wan', 'single'}

local prev_ifnames = {}
for _, role in ipairs(roles) do
	prev_ifnames[role] = sysconfig[role .. '_ifname']
end

if wan_ifname and lan_ifname then
	sysconfig.wan_ifname = wan_ifname
	sysconfig.lan_ifname = lan_ifname
	sysconfig.single_ifname = nil
else
	sysconfig.wan_ifname = nil
	sysconfig.lan_ifname = nil
	sysconfig.single_ifname = lan_ifname or wan_ifname
end

local function split(ifnames)
	local ret = {}
	for ifname in string.gmatch(ifnames or '', '%S+') do
		table.insert(ret, ifname)
	end
	return ret
end

-- The defaults are derived from the order of the interfaces, which may
-- change between OpenWrt releases (driver probe order), between boots for
-- USB interfaces, and when an interface is added. On x86, the names given by
-- rename-netif do not depend on this order, so the roles stay on their
-- interfaces as long as these still exist.
--
-- When an interface is gone or the number of interfaces of a role has
-- changed, the defaults apply.
local function keep_roles()
	for _, role in ipairs(roles) do
		local prev = split(prev_ifnames[role])
		if #prev ~= #split(sysconfig[role .. '_ifname']) then
			return
		end

		for _, ifname in ipairs(prev) do
			if not (util.is_stable_netdev_name(ifname) and unistd.access('/sys/class/net/' .. ifname)) then
				return
			end
		end
	end

	for _, role in ipairs(roles) do
		sysconfig[role .. '_ifname'] = prev_ifnames[role]
	end
end

if platform.match('x86') then
	keep_roles()
end

-- Migrate interface sections referring to the kernel name of a renamed
-- interface (e.g. VLANs like eth0.8)
uci:foreach('gluon', 'interface', function(interface)
	local base, suffix = string.match(interface.name or '', '^([^/.]+)(.*)$')
	local name = base and not unistd.access('/sys/class/net/' .. base) and util.get_renamed_netdev(base)
	if not name then
		return
	end
	uci:set('gluon', interface['.name'], 'name', name .. suffix)
end)

uci:save('gluon')

-- Delete all UCI device sections of type 'bridge'
-- as well as the ones starting with 'br-'.
-- Preserve all others to apply MAC address stored in UCI
uci:delete_all('network', 'device', function(dev)
	return (dev.type == 'bridge' or dev.name:match('^br-'))
end)

uci:delete_all('network', 'interface')

uci:save('network')
