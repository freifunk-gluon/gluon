#!/usr/bin/lua

local wireless = require 'gluon.wireless'
local uci = require('simple-uci').cursor()

wireless.foreach_radio(uci, function(radio)
	if wireless.has_radio_section(uci, radio) then
		return
	end

	-- Create the settings of a new radio, migrating a transmission power
	-- configured in the wireless config
	wireless.add_radio_section(uci, radio, {
		txpower = radio.txpower,
	})
end)

uci:save('gluon')
